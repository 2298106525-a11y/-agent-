# ============================================
# 学练测一体化能力提升系统 - 环境变量配置
# ============================================
# 使用说明:
# 1. 复制此文件为 .env
# 2. 将占位符替换为实际 API Key
# 3. 不要将 .env 提交到版本控制系统

# ============================================
# LLM 配置 (必需)
# ============================================

# LLM API Key (支持OpenAI兼容接口)
# 阿里云通义千问: https://dashscope.console.aliyun.com/apiKey
LLM_API_KEY=your_api_key_here

# LLM API 基础 URL
# - OpenAI: https://api.openai.com/v1
# - 阿里云通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM 模型名称
# - 阿里云: qwen-plus, qwen-max, qwen-turbo
# - OpenAI: gpt-4o, gpt-4o-mini
LLM_MODEL=qwen-plus

# ============================================
# 流程配置 (可选)
# ============================================

# 最大迭代次数 (默认: 3)
MAX_ITERATIONS=3

# 评估周期 (默认: weekly)
ASSESSMENT_CYCLE=weekly

# ============================================
# 输出配置 (可选)
# ============================================

# 输出目录 (默认: ./output)
OUTPUT_DIR=./output
